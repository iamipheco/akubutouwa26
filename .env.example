# Public address of the site, used for the share image link (no trailing slash).
SITE_URL=https://akubutouwa26.com

# Where RSVP replies are sent (HTTP POST, JSON body).
# Works with any endpoint that accepts JSON: a Google Apps Script web app,
# Formspree, a Netlify/Vercel function, Supabase, etc.
# Leave empty to run in preview mode (replies are kept only in the guest's browser).
VITE_RSVP_ENDPOINT=
